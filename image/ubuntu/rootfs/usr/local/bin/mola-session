#!/bin/bash
set -euo pipefail
export DISPLAY=:1 LIBGL_ALWAYS_SOFTWARE=1
export XDG_RUNTIME_DIR=/run/user/1000
export DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus
mkdir -p "$HOME/.mola/logs"
xfconf-query -c xfwm4 -p /general/use_compositing -n -t bool -s false || true
/usr/local/bin/cua-driver serve >> "$HOME/.mola/logs/cua-driver.log" 2>&1 &
exec startxfce4
