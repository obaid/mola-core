#!/usr/bin/env bash
#
# Start the Omarchy graphical session and expose it over VNC.
#
# Omarchy is Hyprland/Wayland. Hyprland 0.56 renders through aquamarine, which
# needs a DRM render node for buffer allocation on EVERY backend path — DRM,
# nested Wayland, all of them. On a KVM guest that node exists (virtio-gpu), so
# this is the production path and it is the only display path this image has.
#
# There is deliberately no X11/i3 fallback. Substituting a different desktop
# when the real one will not start is how an image ends up being called Omarchy
# while not being Omarchy. If the compositor cannot run, this reports why and
# exits non-zero so the control plane sees an unhealthy machine.
#
# The other job here is keeping the runtime tmpfs from filling. See the log
# containment section below; a machine that loses that loses the ability to
# launch any graphical application, roughly a day after it boots.

set -uo pipefail

# Image-specific compatibility settings, controlled by the image builder.
[ ! -f /etc/mola-session.env ] || source /etc/mola-session.env

log() { printf '{"ts":"%s","level":"%s","source":"session","msg":"%s"}\n' \
        "$(date -u +%FT%TZ)" "$1" "$2"; }

export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/1000}"
export XDG_SESSION_TYPE=wayland
export XDG_CURRENT_DESKTOP=Hyprland
export WLR_RENDERER="${WLR_RENDERER:-pixman}"
export LIBGL_ALWAYS_SOFTWARE="${LIBGL_ALWAYS_SOFTWARE:-1}"

# ---------------------------------------------------------------------------
# Log containment
# ---------------------------------------------------------------------------
#
# Hyprland writes its own log to $XDG_RUNTIME_DIR/hypr/<signature>/hyprland.log
# and never rotates it. These machines have no GPU, so aquamarine reports a
# failed renderer on every commit, and that one file grows by roughly 20 MB an
# hour. XDG_RUNTIME_DIR is a tmpfs sized at a tenth of RAM — 392 MB on a
# default machine — so it fills in well under a day.
#
# What breaks then is not logging. systemd can no longer write transient scope
# units, so `uwsm app` fails and no graphical application can start at all,
# while the shell carries on working perfectly. That is why a machine looks
# healthy right up until somebody tries to open a window, and why this went
# unnoticed long enough to ship.
#
# Two independent guards, because one of them quietly not working is exactly
# how the bug got here:
#
#   1. the instance directory lives on the machine's disk instead of the tmpfs,
#      so runaway logging costs disk rather than the session;
#   2. a watchdog truncates any log past a cap, so it does not fill that
#      either.
#
# Truncating is safe. Hyprland reopens the log in append mode for every line,
# so the next write starts again from zero rather than at a stale offset.

LOG_DIR="${MOLA_LOG_DIR:-/var/log/mola}"
LOG_CAP_BYTES="${MOLA_LOG_CAP_BYTES:-67108864}"     # 64 MiB

contain_logs() {
    # The entrypoint creates this as root; this session runs as `dev` and
    # cannot. Fall back to the home directory rather than giving up: losing
    # the desktop to a full tmpfs is far worse than logging somewhere less
    # tidy.
    mkdir -p "${LOG_DIR}/hypr" 2>/dev/null || LOG_DIR="${HOME}/.mola/log"
    if ! mkdir -p "${LOG_DIR}/hypr" 2>/dev/null; then
        log warn "no writable log directory; Hyprland's log stays on the runtime tmpfs"
        return 1
    fi

    # Instance directories are per-boot. Clearing them keeps the disk copy from
    # accumulating one abandoned log per start, which would reintroduce the
    # same unbounded growth somewhere quieter.
    rm -rf "${LOG_DIR:?}/hypr"/* 2>/dev/null || true

    # Hyprland derives this path from XDG_RUNTIME_DIR and offers no setting to
    # move the log on its own, so the whole directory is redirected. The
    # sockets inside it work identically on disk.
    rm -rf "${XDG_RUNTIME_DIR}/hypr"
    ln -sfn "${LOG_DIR}/hypr" "${XDG_RUNTIME_DIR}/hypr"
    log info "Hyprland logs to ${LOG_DIR}/hypr, capped at ${LOG_CAP_BYTES} bytes"
}

# Truncate anything under the log directory that has outgrown the cap.
truncate_oversized_logs() {
    find "${LOG_DIR}" -type f -size +"$((LOG_CAP_BYTES / 1024))"k 2>/dev/null |
    while IFS= read -r oversized; do
        : > "${oversized}"
        log warn "truncated ${oversized} at the ${LOG_CAP_BYTES} byte cap"
    done
}

# Stop when the compositor does, so a dead session leaves nothing behind. A
# minute is far tighter than 20 MB an hour needs and costs one stat per file.
watch_logs() {
    while kill -0 "${HYPR_PID}" 2>/dev/null; do
        sleep 60
        truncate_oversized_logs
    done
}

# Both halves of the containment can be run on their own. The compositor needs
# a KVM guest and so cannot be exercised anywhere else, but the half that
# actually broke machines is this one, and it is worth being able to check it
# without booting anything.
case "${1:-}" in
    --contain-logs)   contain_logs; exit $? ;;
    --truncate-logs)  truncate_oversized_logs; exit 0 ;;
esac

if [ ! -d /dev/dri ]; then
    log error "no DRM render node (/dev/dri); Hyprland cannot allocate buffers"
    log error "this image needs a virtual GPU — it runs on KVM (virtio-gpu), not in a container"
    exit 78   # EX_CONFIG: the environment is wrong, not the image
fi

log info "DRM present: $(ls /dev/dri | tr '\n' ' ')"

contain_logs || true

# seatd gives the compositor a seat when there is no logind session.
if [ ! -S /run/seatd.sock ]; then
    seatd -g seat >>"${LOG_DIR}/seatd.log" 2>&1 &
    for _ in $(seq 1 25); do [ -S /run/seatd.sock ] && break; sleep 0.2; done
fi

# Append, so the watchdog's truncation leaves the file usable.
Hyprland >>"${LOG_DIR}/hyprland-session.log" 2>&1 &
HYPR_PID=$!

watch_logs &

# Wait for the compositor's Wayland socket rather than sleeping and hoping.
for _ in $(seq 1 100); do
    for s in "${XDG_RUNTIME_DIR}"/wayland-*; do
        case "$s" in *.lock) continue ;; esac
        [ -S "$s" ] && export WAYLAND_DISPLAY="$(basename "$s")" && break 2
    done
    kill -0 "$HYPR_PID" 2>/dev/null || { log error "Hyprland exited during startup"; exit 1; }
    sleep 0.2
done

if [ -z "${WAYLAND_DISPLAY:-}" ]; then
    log error "Hyprland produced no Wayland socket within 20s"
    exit 1
fi

log info "compositor up on ${WAYLAND_DISPLAY}"

# The Cua daemon must inherit the compositor's own Wayland and session-bus
# identity. A systemd user service supervises it on KVM; the direct fallback
# covers guests without a user systemd manager.
if systemctl --user show-environment >/dev/null 2>&1; then
    if systemctl --user import-environment XDG_RUNTIME_DIR WAYLAND_DISPLAY XDG_SESSION_TYPE XDG_CURRENT_DESKTOP DBUS_SESSION_BUS_ADDRESS \
        && systemctl --user restart mola-cua-driver.service; then
        log info "Cua Driver started in the graphical user session"
    else
        log warn "Cua Driver user service failed; desktop remains available"
    fi
else
    /usr/local/bin/cua-driver serve >>"${LOG_DIR}/cua-driver.log" 2>&1 &
    log info "Cua Driver started without a user systemd manager"
fi

# wayvnc speaks wlr-screencopy, which Hyprland implements. It binds to all
# interfaces inside the guest only because the guest's own network is private;
# nothing reaches it except the authenticated Mola desktop gateway.
exec wayvnc --render-cursor 0.0.0.0 5900
